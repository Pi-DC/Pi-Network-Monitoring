#!/usr/bin/env python3
"""Move every e-mail from this server to the monitoring@ sender once Office365 accepts mail from it (2026-10-13).

Office365 rejected every send from monitoring@ ("554 5.2.2 Mailbox full", a folder at its item-count limit), so
alerts@ stays the sender until a test send works. Cron /etc/cron.d/pidc-sender-switch runs this every 15 min
(log /var/log/zabbix/sender-switch.log). On the first successful send it:
  1. e-mails a test alert from monitoring@ to compute@ / network@,
  2. makes monitoring@ the sender everywhere (smtp_sender / smtp_password, read by the Zabbix Office365 media
     type, send_daily_reports.py, watchdog.py and ssl/manual-auth-hook.sh),
  3. e-mails a test daily PDF report (ASR Routers, yesterday) through send_daily_reports.py,
  4. deletes the alerts@ password and this cron job.
"""
import os
import smtplib
import subprocess
import sys
import time
from email.message import EmailMessage

import setup_isp_links as base
import setup_email_alerts as mail

NEW_SENDER = "monitoring@pidatacenters.com"
NEW_PASSWORD_FILE = "/root/.credentials/smtp_monitoring_password"
OLD_PASSWORD_FILE = "/root/.credentials/smtp_alerts_password"
CRON_FILE = "/etc/cron.d/pidc-sender-switch"


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def write(path, text):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def test_send(password):
    msg = EmailMessage()
    msg["From"], msg["To"] = NEW_SENDER, ", ".join(mail.RECIPIENTS)
    msg["Subject"] = f"TEST: e-mails from isp.picloud.in now come from {NEW_SENDER}"
    msg.set_content(f"Test e-mail: Zabbix alerts, daily PDF reports, watchdog and SSL renewal e-mails from the "
                    f"monitoring server (isp.picloud.in) are now sent from {NEW_SENDER}; alerts@pidatacenters.com "
                    "is no longer used. A test daily PDF report (ASR Routers) follows in a separate e-mail.\n\n"
                    "No action needed.")
    with smtplib.SMTP("smtp.office365.com", 587, timeout=60) as s:
        s.starttls()
        s.login(NEW_SENDER, password)
        s.send_message(msg)


def main():
    if base.read(mail.SENDER_FILE) == NEW_SENDER and not os.path.exists(OLD_PASSWORD_FILE):
        log(f"already switched to {NEW_SENDER}")
        return
    password = base.read(NEW_PASSWORD_FILE if os.path.exists(NEW_PASSWORD_FILE) else mail.PASSWORD_FILE)
    try:
        test_send(password)
    except (smtplib.SMTPException, OSError) as e:
        log(f"{NEW_SENDER} still cannot send, keeping the current sender: {str(e)[:160]}")
        return
    log(f"test alert sent from {NEW_SENDER} to {', '.join(mail.RECIPIENTS)}")

    write(mail.PASSWORD_FILE, password)
    write(mail.SENDER_FILE, NEW_SENDER)
    mt = mail.apply_sender(base.Zabbix())
    log(f"Office365 media type {mt} now sends as {NEW_SENDER}; daily reports, watchdog, SSL hook follow the same files")

    r = subprocess.run([sys.executable, "send_daily_reports.py", "--only", "ASR Routers"],
                       cwd=os.path.dirname(os.path.abspath(__file__)), capture_output=True, text=True, timeout=1800)
    log("test daily report: " + (r.stdout + r.stderr).strip().replace("\n", " | ")[-300:])

    for path in (OLD_PASSWORD_FILE, NEW_PASSWORD_FILE, CRON_FILE):
        if os.path.exists(path):
            os.remove(path)
    log("alerts@ password and the switch cron job removed - done")


if __name__ == "__main__":
    main()
